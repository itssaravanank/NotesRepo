### db_TaxAmtReports — Modified Stored Procedure

`usp_cta_GetTARBillingFile_sel` is extended with `IF/ELSE IF` blocks per customer. Each branch has an independent query plan and only the 2161/2164 branches incur the `lac_CountyInfo` JOIN. The `ELSE` branch preserves all original 6a logic unchanged.

> **Adding a new customer in future:** add a new `ELSE IF @CustId = 'XXXX'` block before the `ELSE`.

```sql
CREATE OR ALTER PROCEDURE [dbo].[usp_cta_GetTARBillingFile_sel]
    @CustId  VARCHAR(5),
    @RunName VARCHAR(8),
    @RunDate DATETIME
AS
BEGIN
    SET NOCOUNT ON;

    -- All rows; AmtToPay NULL when InstallmentInd outside 1-4; no AgencyName
    IF @CustId = '1072'
    BEGIN
        SELECT
            ri.LoanId,
            ri.TaxId,
            CASE WHEN ri.InstallmentInd IN ('1','2','3','4')
                 THEN CASE ri.InstallmentInd
                          WHEN '1' THEN ri.FirstInstallAmt
                          WHEN '2' THEN ri.SecondInstallAmt
                          WHEN '3' THEN ri.ThirdInstallAmt
                          WHEN '4' THEN ri.FourthInstallAmt
                      END
                 ELSE NULL
            END                                                   AS AmtToPay,
            ri.NextELDDate                                        AS DueDate,
            COALESCE(NULLIF(ri.AgencyId, ''), ri.VendorAgencyId)  AS PayeeCode
        FROM [db_TaxAmtReports].[dbo].[tbl_cta_ReportedItems] ri WITH (NOLOCK)
        WHERE ri.CustId     = @CustId
          AND ri.CTARunName = @RunName
          AND CAST(ri.CTARunDate AS DATE) = CAST(@RunDate AS DATE)
          AND ri.Paid_Items = 'Y'
          AND (ri.DROPPED IS NULL OR ri.DROPPED <> 'Y')
        ORDER BY ri.LoanId;
    END

    -- Standard TaxId; AgencyId fallback PayeeCode; with AgencyName
    ELSE IF @CustId = '2118'
    BEGIN
        SELECT
            ri.LoanId,
            ri.TaxId,
            CASE ri.InstallmentInd
                WHEN '1' THEN ri.FirstInstallAmt
                WHEN '2' THEN ri.SecondInstallAmt
                WHEN '3' THEN ri.ThirdInstallAmt
                WHEN '4' THEN ri.FourthInstallAmt
                ELSE ri.FirstInstallAmt
            END                                                   AS AmtToPay,
            ri.NextELDDate                                        AS DueDate,
            COALESCE(NULLIF(ri.AgencyId, ''), ri.VendorAgencyId)  AS PayeeCode,
            LEFT(ri.AgencyName, 26)                               AS AgencyName
        FROM [db_TaxAmtReports].[dbo].[tbl_cta_ReportedItems] ri WITH (NOLOCK)
        WHERE ri.CustId     = @CustId
          AND ri.CTARunName = @RunName
          AND CAST(ri.CTARunDate AS DATE) = CAST(@RunDate AS DATE)
          AND ri.Paid_Items = 'Y'
          AND (ri.DROPPED IS NULL OR ri.DROPPED <> 'Y')
        ORDER BY ri.LoanId;
    END

    -- Michigan county prefix on TaxId (leading zero dropped); VendorAgencyId always as PayeeCode
    ELSE IF @CustId = '2161'
    BEGIN
        SELECT
            ri.LoanId,
            LEFT(SUBSTRING(ci.county_code, 2, LEN(ci.county_code)) + ri.TaxId, 40) AS TaxId,
            CASE ri.InstallmentInd
                WHEN '1' THEN ri.FirstInstallAmt
                WHEN '2' THEN ri.SecondInstallAmt
                WHEN '3' THEN ri.ThirdInstallAmt
                WHEN '4' THEN ri.FourthInstallAmt
                ELSE ri.FirstInstallAmt
            END                                                   AS AmtToPay,
            ri.NextELDDate                                        AS DueDate,
            ri.VendorAgencyId                                     AS PayeeCode,
            LEFT(ri.AgencyName, 26)                               AS AgencyName
        FROM [db_TaxAmtReports].[dbo].[tbl_cta_ReportedItems] ri WITH (NOLOCK)
        LEFT JOIN [LASCommon].[dbo].[lac_CountyInfo] ci WITH (NOLOCK)
            ON ci.state_code = '26'
            AND ci.FIPS = SUBSTRING(ri.AgencyId, 3, 3)
        WHERE ri.CustId     = @CustId
          AND ri.CTARunName = @RunName
          AND CAST(ri.CTARunDate AS DATE) = CAST(@RunDate AS DATE)
          AND ri.Paid_Items = 'Y'
          AND (ri.DROPPED IS NULL OR ri.DROPPED <> 'Y')
        ORDER BY ri.LoanId;
    END

    -- Michigan county prefix + strip leading zero from TaxId (see Assumption A2); AgencyId fallback PayeeCode
    ELSE IF @CustId = '2164'
    BEGIN
        SELECT
            ri.LoanId,
            LEFT(
                SUBSTRING(ci.county_code, 2, LEN(ci.county_code))
                + LTRIM(REPLACE(ri.TaxId, '0', ' ')),  -- leading-zero strip placeholder; confirm with sample TaxId
                40
            )                                                     AS TaxId,
            CASE ri.InstallmentInd
                WHEN '1' THEN ri.FirstInstallAmt
                WHEN '2' THEN ri.SecondInstallAmt
                WHEN '3' THEN ri.ThirdInstallAmt
                WHEN '4' THEN ri.FourthInstallAmt
                ELSE ri.FirstInstallAmt
            END                                                   AS AmtToPay,
            ri.NextELDDate                                        AS DueDate,
            COALESCE(NULLIF(ri.AgencyId, ''), ri.VendorAgencyId)  AS PayeeCode,
            LEFT(ri.AgencyName, 26)                               AS AgencyName
        FROM [db_TaxAmtReports].[dbo].[tbl_cta_ReportedItems] ri WITH (NOLOCK)
        LEFT JOIN [LASCommon].[dbo].[lac_CountyInfo] ci WITH (NOLOCK)
            ON ci.state_code = '26'
            AND ci.FIPS = SUBSTRING(ri.AgencyId, 3, 3)
        WHERE ri.CustId     = @CustId
          AND ri.CTARunName = @RunName
          AND CAST(ri.CTARunDate AS DATE) = CAST(@RunDate AS DATE)
          AND ri.Paid_Items = 'Y'
          AND (ri.DROPPED IS NULL OR ri.DROPPED <> 'Y')
        ORDER BY ri.LoanId;
    END

    -- Standard TaxId; VendorAgencyId always as PayeeCode; with AgencyName
    ELSE IF @CustId = '2215'
    BEGIN
        SELECT
            ri.LoanId,
            ri.TaxId,
            CASE ri.InstallmentInd
                WHEN '1' THEN ri.FirstInstallAmt
                WHEN '2' THEN ri.SecondInstallAmt
                WHEN '3' THEN ri.ThirdInstallAmt
                WHEN '4' THEN ri.FourthInstallAmt
                ELSE ri.FirstInstallAmt
            END                                                   AS AmtToPay,
            ri.NextELDDate                                        AS DueDate,
            ri.VendorAgencyId                                     AS PayeeCode,
            LEFT(ri.AgencyName, 26)                               AS AgencyName
        FROM [db_TaxAmtReports].[dbo].[tbl_cta_ReportedItems] ri WITH (NOLOCK)
        WHERE ri.CustId     = @CustId
          AND ri.CTARunName = @RunName
          AND CAST(ri.CTARunDate AS DATE) = CAST(@RunDate AS DATE)
          AND ri.Paid_Items = 'Y'
          AND (ri.DROPPED IS NULL OR ri.DROPPED <> 'Y')
        ORDER BY ri.LoanId;
    END

    -- Original 6a logic (customers 1085, 1090, 1096, 2132) — unchanged
    ELSE
    BEGIN
        SELECT
            LoanId,
            TaxId,
            CASE InstallmentInd
                WHEN '1' THEN FirstInstallAmt
                WHEN '2' THEN SecondInstallAmt
                WHEN '3' THEN ThirdInstallAmt
                WHEN '4' THEN FourthInstallAmt
                ELSE FirstInstallAmt
            END AS AmountToPay,
            NextELDDate
        FROM [db_TaxAmtReports].[dbo].[tbl_cta_ReportedItems] WITH (NOLOCK)
        WHERE CustId     = @CustId
          AND CTARunName = @RunName
          AND CAST(CTARunDate AS DATE) = CAST(@RunDate AS DATE)
          AND Paid_Items = 'Y'
          AND (DROPPED IS NULL OR DROPPED <> 'Y')
        ORDER BY LoanId;
    END
END
```

