```sql
ELSE IF @CustId = '1055'
BEGIN
    SELECT
        ri.AgencyId,
        RIGHT('0000000' + ri.CustId, 7) + ri.LoanId       AS LoanRef,
        ri.TaxId,
        '0000000000'                                       AS DiscTotal,
        ISNULL(ri.FirstInstallAmt,  0)                     AS Inst1,
        ISNULL(ri.SecondInstallAmt, 0)                     AS Inst2,
        ISNULL(ri.ThirdInstallAmt,  0)                     AS Inst3,
        ISNULL(ri.FourthInstallAmt, 0)                     AS Inst4,
        ISNULL(ri.FirstInstallAmt,  0) + ISNULL(ri.SecondInstallAmt, 0)
            + ISNULL(ri.ThirdInstallAmt, 0) + ISNULL(ri.FourthInstallAmt, 0) AS InstTotal,
        CASE
            WHEN LEN(ri.VendorAgencyId) = 10 AND LEFT(ri.VendorAgencyId, 2) = '48'
                THEN '9' + SUBSTRING(ri.VendorAgencyId, 3, 8)
            WHEN LEN(ri.VendorAgencyId) = 10
