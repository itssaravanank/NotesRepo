--- Query to verify a specific loan's eligibility for exception creation or update based on the winning ELD date and the number of days late. 

DECLARE @LoanID VARCHAR(21) = '<your LoanID>';
DECLARE @StartDays INT;
SELECT @StartDays = ConfigValue FROM [LASCommon].[dbo].[tbl_Config_Master] WITH (NOLOCK)
WHERE ConfigSystemCode = 'EPQ' AND ConfigKey = 'StartDays';

;WITH Piv AS (
    SELECT PayeeID, CurrentTaxYear, Installment,
           MAX(CASE WHEN RunCode='ELD0' THEN PayeeCalendarID END) AS ELD0_ID,
           MAX(CASE WHEN RunCode='ELDH' THEN PayeeCalendarID END) AS ELDH_ID,
           MAX(CASE WHEN RunCode='ELDX' THEN PayeeCalendarID END) AS ELDX_ID,
           MAX(TRY_CAST(DueDate AS DATETIME)) AS WinningELDDate
    FROM LASTotalTaxSolution.dbo.lais_PayeeCalendar WITH (NOLOCK)
    WHERE RunCode IN ('ELDH','ELDX','ELD0') AND ISNULL(DueDate,'') <> ''
    GROUP BY PayeeID, CurrentTaxYear, Installment
)
SELECT
    LM.LoanID, LM.PayeeID AS AgencyID, LM.TaxID, LM.PropertyID, LM.LienSEQ, LM.LenderID, LM.Statecode,
    LM.TaxServiceType,
    CASE WHEN LM.TaxServiceType = 'B' THEN 'PASS' ELSE 'FAIL - TaxServiceType must be B' END AS Check_TaxServiceType,
    CM.LCR_CANCEL_CODE,
    CASE WHEN ISNULL(CM.LCR_CANCEL_CODE,'') <> 'C' THEN 'PASS' ELSE 'FAIL - contract is cancelled' END AS Check_NotCancelled,
    ES.DLQResearchInd,
    CASE WHEN ES.DLQResearchInd = '1' THEN 'PASS' ELSE 'FAIL - no/wrong ExceptionService config for this Lender+State' END AS Check_ESConfig,
    ap.Late_Rels,
    CASE WHEN ISNULL(ap.Late_Rels,'') <> 'U' THEN 'PASS' ELSE 'FAIL - agency Late_Rels = U (excluded)' END AS Check_LateRels,
    ap.CURRENT_TAX_YEAR AS AgencyCurrentTaxYear, P.CurrentTaxYear AS InstallmentTaxYear,
    CASE WHEN ap.CURRENT_TAX_YEAR = P.CurrentTaxYear THEN 'PASS' ELSE 'FAIL - tax year mismatch (Gap 2)' END AS Check_TaxYearMatch,
    P.WinningELDDate, DATEDIFF(DAY, P.WinningELDDate, GETDATE()) AS DaysLateNow,
    CASE WHEN DATEDIFF(DAY, P.WinningELDDate, GETDATE()) = @StartDays THEN 'PASS'
         ELSE 'FAIL - not exactly ' + CAST(@StartDays AS VARCHAR) + ' days late (move PayeeCalendarID below)' END AS Check_ExactDaysLate,
    COALESCE(P.ELD0_ID, P.ELDH_ID, P.ELDX_ID) AS PayeeCalendarID_ToUpdate,
    CASE WHEN EXISTS (
        SELECT 1 FROM LASTax.dbo.tbl_ExceptionQueue eq WITH (NOLOCK)
        WHERE eq.LoanID = LM.LoanID AND eq.AgencyID = LM.PayeeID
          AND eq.TaxID = LM.TaxID AND eq.PropertyID = LM.PropertyID AND eq.LienSEQ = LM.LienSEQ
    ) THEN 'Existing record found - this would UPDATE, not CREATE' ELSE 'No existing record - this would CREATE' END AS Check_ExistingRecord
FROM LASTax.dbo.Lat_LienMasterKey LM WITH (NOLOCK)
LEFT JOIN LASTax.dbo.lat_ContractMasterKey CM WITH (NOLOCK) ON CM.LCR_CONTRACT_ID = LM.ContractID
LEFT JOIN LASTax.dbo.tbl_ExceptionQueue_Assign_ExceptionService ES WITH (NOLOCK)
    ON ES.LenderID = LM.LenderID AND ES.STATE_CODE = LM.Statecode
LEFT JOIN LASCommon.dbo.lac_AgencyProfile ap WITH (NOLOCK) ON ap.AGENCY_ID = LM.PayeeID
LEFT JOIN Piv P ON P.PayeeID = LM.PayeeID
WHERE LM.LoanID = @LoanID;