## 3. Database Changes

**Database:** `LASTax`. No schema changes — data-only script against existing tables.

### Identification (population snapshot)
Mirrors `USP_ExceptionQueue_FollowUp_Sel`'s own eligibility logic exactly, run with no
Lender/Agency/Customer/User filter (i.e., system-wide — everything currently on the Follow-Up
tab for any user), captured once into a temp table so every later step operates against a
stable snapshot rather than a criteria set that shifts as rows are updated mid-script:

```sql
SELECT
    UT.ID            AS UserTrackingID,
    UT.ExceptionID,
    UT.SystemCode,
    UT.SeqNo,
    UT.TaggedUser    AS OldTaggedUser,
    CAST(CASE WHEN ISNULL(UT.isComplete,0) = 1 THEN 1 ELSE 0 END AS BIT) AS WasAlreadyComplete
INTO #EligibleFollowUp
FROM (
    SELECT MAX(UT2.SeqNo) AS SeqNo, EQ2.ExceptionID, UT2.SystemCode
    FROM [LASTax].[dbo].[tbl_ExceptionQueue_FollowUp_Notes] FN2 WITH (NOLOCK)
    JOIN [LASTax].[dbo].[tbl_ExceptionQueue] EQ2 WITH (NOLOCK) ON EQ2.ExceptionID = FN2.ExceptionID
    JOIN [LASTax].[dbo].[tbl_ExceptionQueue_UserTracking] UT2 WITH (NOLOCK)
        ON UT2.ExceptionID = EQ2.ExceptionID AND UT2.SystemCode = FN2.SystemCode
           AND ISNULL(FN2.SeqNo,0) = ISNULL(UT2.SeqNo,0)
    WHERE ISNULL(UT2.isFollowUp,0) = 1 AND FN2.FollowUpDate <> '' AND ISNULL(FN2.isFollowUp,0) = 1
    GROUP BY EQ2.ExceptionID, UT2.SystemCode
) Eligible
JOIN [LASTax].[dbo].[tbl_ExceptionQueue_UserTracking] UT WITH (NOLOCK)
    ON UT.ExceptionID = Eligible.ExceptionID AND UT.SystemCode = Eligible.SystemCode
       AND ISNULL(UT.SeqNo,0) = ISNULL(Eligible.SeqNo,0);
```

### Full proposed script

```sql
USE [LASTax]
GO

SET NOCOUNT ON;

DECLARE @ClosedBy  VARCHAR(20)  = 'EPQClean-129257';  -- pending final label pick, see Open Q1
DECLARE @Now       DATETIME     = GETDATE();
DECLARE @NoteText  VARCHAR(250) = 'Closed as part of the Follow-Up duplicates cleanup.';

BEGIN TRY
    BEGIN TRANSACTION EPQFollowUpBulkCleanup;

    -- (identification query from above populates #EligibleFollowUp here)

    -- Archive UserTracking rows about to change
    INSERT INTO [dbo].[tbl_ExceptionQueue_UserTracking_Archive]
        ([ExceptionID],[SeqNo],[isComplete],[isFollowUp],[TaggedUser],[CompletedDate],[FollowUpDate],
         [InsertedDate],[InsertedBy],[UpdatedDate],[UpdatedBy],[SystemCode],[isPendingQC],[ID],[ArchivedDate],[ArchivedBy])
    SELECT UT.[ExceptionID],UT.[SeqNo],UT.[isComplete],UT.[isFollowUp],UT.[TaggedUser],UT.[CompletedDate],UT.[FollowUpDate],
           UT.[InsertedDate],UT.[InsertedBy],UT.[UpdatedDate],UT.[UpdatedBy],UT.[SystemCode],UT.[isPendingQC],UT.[ID],@Now,@ClosedBy
    FROM [dbo].[tbl_ExceptionQueue_UserTracking] UT
    JOIN #EligibleFollowUp E ON E.UserTrackingID = UT.ID;

    -- Genuinely-open rows -> full completion stamp
    UPDATE UT
    SET UT.isComplete = 1, UT.isFollowUp = 0, UT.isPendingQC = 0,
        UT.CompletedDate = @Now, UT.TaggedUser = @ClosedBy, UT.UpdatedBy = @ClosedBy, UT.UpdatedDate = @Now
    FROM [dbo].[tbl_ExceptionQueue_UserTracking] UT
    JOIN #EligibleFollowUp E ON E.UserTrackingID = UT.ID
    WHERE E.WasAlreadyComplete = 0;

    -- Already-complete rows -> clear flags only, preserve original completion info
    UPDATE UT
    SET UT.isFollowUp = 0, UT.isPendingQC = 0, UT.UpdatedDate = @Now
    FROM [dbo].[tbl_ExceptionQueue_UserTracking] UT
    JOIN #EligibleFollowUp E ON E.UserTrackingID = UT.ID
    WHERE E.WasAlreadyComplete = 1;

    -- Archive the FollowUp_Notes rows about to change
    INSERT INTO [dbo].[tbl_ExceptionQueue_FollowUp_Notes_Archive]
        ([LoanNotesID],[ExceptionID],[LoanID],[CustID],[LenderID],[AgencyID],[TaxID],[LienSEQ],[NoteEnteredDate],
         [UserID],[NoteText],[isFollowUp],[FollowUpDate],[NoteUpdatedDate],[UpdatedBy],[SystemCode],[ArchivedDate],[ArchivedBy],SeqNo)
    SELECT FN.[LoanNotesID],FN.[ExceptionID],FN.[LoanID],FN.[CustID],FN.[LenderID],FN.[AgencyID],FN.[TaxID],FN.[LienSEQ],FN.[NoteEnteredDate],
           FN.[UserID],FN.[NoteText],FN.[isFollowUp],FN.[FollowUpDate],FN.[NoteUpdatedDate],FN.[UpdatedBy],FN.[SystemCode],@Now,@ClosedBy,FN.SeqNo
    FROM [dbo].[tbl_ExceptionQueue_FollowUp_Notes] FN
    JOIN #EligibleFollowUp E ON E.ExceptionID = FN.ExceptionID AND E.SystemCode = FN.SystemCode AND ISNULL(E.SeqNo,0) = ISNULL(FN.SeqNo,0)
    WHERE ISNULL(FN.isFollowUp,0) = 1 AND FN.FollowUpDate <> '';

    -- Clear the active flag on those existing note rows (original NoteText untouched)
    UPDATE FN
    SET FN.isFollowUp = 0, FN.NoteUpdatedDate = @Now, FN.UpdatedBy = @ClosedBy
    FROM [dbo].[tbl_ExceptionQueue_FollowUp_Notes] FN
    JOIN #EligibleFollowUp E ON E.ExceptionID = FN.ExceptionID AND E.SystemCode = FN.SystemCode AND ISNULL(E.SeqNo,0) = ISNULL(FN.SeqNo,0)
    WHERE ISNULL(FN.isFollowUp,0) = 1 AND FN.FollowUpDate <> '';

    -- Insert the standardized closure note (one new row per task)
    INSERT INTO [dbo].[tbl_ExceptionQueue_FollowUp_Notes]
        ([ExceptionID],[LoanID],[CustID],[LenderID],[AgencyID],[TaxID],[LienSEQ],[NoteEnteredDate],
         [UserID],[NoteText],[isFollowUp],[FollowUpDate],[UpdatedBy],[SystemCode],[SeqNo])
    SELECT EQ.[ExceptionID],EQ.[LoanID],EQ.[CustID],EQ.[LenderID],EQ.[AgencyID],EQ.[TaxID],EQ.[LienSEQ],@Now,
           @ClosedBy,@NoteText,0,NULL,@ClosedBy,E.SystemCode,E.SeqNo
    FROM #EligibleFollowUp E
    JOIN [dbo].[tbl_ExceptionQueue] EQ ON EQ.ExceptionID = E.ExceptionID;

    -- Audit trail entry per task
    INSERT INTO [dbo].[tbl_ExceptionQueue_History]
        ([ExceptionID],[CustID],[LenderID],[LoanID],[AgencyID],[TaxID],[LienSEQ],[OldValue],[NewValue],[Comments],[InsertedDate],[InsertedBy],SystemCode,SeqNo)
    SELECT EQ.[ExceptionID],EQ.[CustID],EQ.[LenderID],EQ.[LoanID],EQ.[AgencyID],EQ.[TaxID],EQ.[LienSEQ],
           E.OldTaggedUser, @ClosedBy, @NoteText, @Now, @ClosedBy, E.SystemCode, E.SeqNo
    FROM #EligibleFollowUp E
    JOIN [dbo].[tbl_ExceptionQueue] EQ ON EQ.ExceptionID = E.ExceptionID;

    SELECT COUNT(*) AS TotalProcessed,
           SUM(CASE WHEN WasAlreadyComplete = 0 THEN 1 ELSE 0 END) AS NewlyClosed,
           SUM(CASE WHEN WasAlreadyComplete = 1 THEN 1 ELSE 0 END) AS FlagOnlyCleared
    FROM #EligibleFollowUp;

    COMMIT TRANSACTION EPQFollowUpBulkCleanup;
    PRINT 'EPQ Follow-Up bulk cleanup completed successfully.';
END TRY
BEGIN CATCH
    IF XACT_STATE() <> 0 ROLLBACK TRANSACTION EPQFollowUpBulkCleanup;
    THROW;
END CATCH
```

